# Copy to .env and fill in. Everything is optional — the app runs without it.

# LLM. Leave blank to use the deterministic planner (offline demo mode).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# PayPal. "mock" works offline and is what judges will use.
# "live" hits the real sandbox and requires the two values below.
# Create a REST app at https://developer.paypal.com/ and put its *sandbox*
# credentials in backend/.env — never in this file, which is committed.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Storage
PAYPILOT_DB=paypilot.db

# Safety rails (override per-merchant in DB)
MAX_AGENT_STEPS=12
